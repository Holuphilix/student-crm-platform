{
  "name": "student-crm-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml --port 8787",
    "dev:root-config": "wrangler dev --config ../wrangler.jsonc --port 8787",
    "deploy": "wrangler deploy",
    "deploy:root-config": "wrangler deploy --config ../wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:root-dry-run": "wrangler deploy --dry-run --config ../wrangler.jsonc",
    "seed:demo-users": "node scripts/seed-demo-users.mjs",
    "verify:demo-users": "node scripts/verify-demo-users.mjs",
    "verify:schema": "node scripts/verify-crm-schema.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "@supabase/supabase-js": "^2.106.2",
    "hono": "^4.10.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260521.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.52.0"
  }
}
